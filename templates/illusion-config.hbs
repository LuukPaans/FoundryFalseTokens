<div class="false-tokens-config-body">
  <div class="form-group">
    <label>{{localize "FALSETOKENS.Active"}}</label>
    <input type="checkbox" name="active" {{checked active}} />
  </div>

  <div class="form-group">
    <label>{{localize "FALSETOKENS.Type"}}</label>
    <select name="type">
      <option value="illusion" {{#unless isInvisible}}selected{{/unless}}>{{localize "FALSETOKENS.TypeIllusion"}}</option>
      <option value="invisible" {{#if isInvisible}}selected{{/if}}>{{localize "FALSETOKENS.TypeInvisible"}}</option>
    </select>
  </div>

  {{!-- Always rendered so its value survives a type switch; only hidden for invisible mode. --}}
  <div class="form-group false-tokens-illusion-only" {{#if isInvisible}}hidden{{/if}}>
    <label>{{localize "FALSETOKENS.IllusionImage"}}</label>
    <div class="form-fields">
      <input type="text" name="illusionImg" value="{{illusionImg}}"
        placeholder="{{localize 'FALSETOKENS.IllusionImagePlaceholder'}}" />
      <button type="button" data-action="pickIllusion" data-target="illusionImg">
        <i class="fa-solid fa-file-image"></i>
      </button>
    </div>
    <p class="hint">{{localize "FALSETOKENS.IllusionImageHint"}}</p>
  </div>

  <fieldset class="false-tokens-user-list">
    <legend>
      <span class="false-tokens-illusion-only" {{#if isInvisible}}hidden{{/if}}>{{localize "FALSETOKENS.LegendIllusion"}}</span>
      <span class="false-tokens-invisible-only" {{#unless isInvisible}}hidden{{/unless}}>{{localize "FALSETOKENS.LegendInvisible"}}</span>
    </legend>
    <div class="false-tokens-bulk-actions">
      <button type="button" data-action="allTrue">{{localize "FALSETOKENS.MarkEveryone"}}</button>
      <button type="button" data-action="allFalse">{{localize "FALSETOKENS.ClearEveryone"}}</button>
    </div>
    {{#each users}}
      <label class="checkbox">
        <input type="checkbox" name="fooled.{{this.id}}" {{checked this.fooled}} />
        {{this.name}}
      </label>
    {{/each}}
    {{#unless users.length}}
      <p class="hint">{{localize "FALSETOKENS.NoPlayers"}}</p>
    {{/unless}}
  </fieldset>
</div>
